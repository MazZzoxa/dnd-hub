<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Preserve the current SQLite database for Android reinstall/cloud restore. -->
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>

    <!-- Preserve the database for device-to-device transfer. -->
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
